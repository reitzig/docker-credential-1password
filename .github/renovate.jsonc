{
  "extends": [
    "config:best-practices",
    "schedule:weekly"
  ],
  "labels": [
    "dependencies",
    "no changelog"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "mise": {
    "rangeStrategy": "update-lockfile"
  },
  "minimumReleaseAge": "3d",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "digest",
        "lockFileMaintenance",
        "patch",
        "pin",
        "pinDigest"
      ],
      "groupName": "patches",
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "schedule": [
        "before 9am on the first day of the month"
      ]
    }
  ]
}
